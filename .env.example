# =============================================================================
# REQUIRED — the app will not start without these
# =============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Database connection (used directly when running without Docker)
DATABASE_URL=postgresql+asyncpg://analyst:YOUR_PASSWORD_HERE@localhost:5432/analyst_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Postgres credentials (used by docker-compose to create the DB container)
POSTGRES_USER=analyst
POSTGRES_PASSWORD=
POSTGRES_DB=analyst_db

# =============================================================================
# Admin seed user (used by: python -m app.seed)
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# =============================================================================
# LLM Providers — set at least one
# =============================================================================
LLM_DEFAULT_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Optional — safe defaults are used if not set
# =============================================================================

# Application
APP_NAME=the-analyst-api
APP_VERSION=0.1.0
DEBUG=false

# File Upload Limits
MAX_FILE_SIZE_MB=500
MAX_TOTAL_UPLOAD_MB=1024
MAX_FILES_PER_UPLOAD=10
MAX_TABLES_PER_DATASET=20

# Storage
STORAGE_DIR=./storage

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cache
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=3600
